+
+    async def test_missing_init_ack_is_not_reported_as_live(self):
+        from src.engine import Engine
+        from types import SimpleNamespace
+        config.public, config.patch = self.saved[2:]
+        engine = Engine()
+        engine._build_body = lambda overrides: ({'model':'vidu-s2'}, {'mode':'managed'})
+        engine._pump=AsyncMock(); engine._watchdog=AsyncMock(); engine._dan_watchdog_loop=AsyncMock()
+        self.r = ls.LocalRuntime(engine); self.r.obs_present_at = time.time()
+        sig = SimpleNamespace(connect=AsyncMock(), conn_init=AsyncMock(return_value=False),
+            hangup=AsyncMock(), close=AsyncMock())
+        with patch.object(ls.vidu, 'create_component', AsyncMock(return_value={'live': {'id':'fake-session'}})), \
