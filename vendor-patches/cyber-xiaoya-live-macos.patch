+  requestVideoFrameCallback:fn=>{frame=fn;return 1},cancelVideoFrameCallback:()=>{}};
+ t.nodes.videoWrap.querySelectorAll=()=>[t.nodes.video,remote];
+ await t.ctx.sync({active:true,live_id:'live'});await t.timers[0]();assert.equal(typeof frame,'function');
+ frame();let body;t.ctx.api=async(_,opt)=>{body=JSON.parse(opt.body);return {ok:true}};await t.timers[0]();
+ assert.equal(body.frame,true);
+});
+test('settings and voice-panel controls have distinct ids',()=>{
+ const ids=[...html.split('<script>')[0].matchAll(/\bid="([^"]+)"/g)].map(m=>m[1]);
+ assert.equal(new Set(ids).size,ids.length);
+});
+test('cancel control is visible while a create request is pending',async()=>{
