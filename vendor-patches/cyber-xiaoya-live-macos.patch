+"""macOS speech adapter. Upstream still owns sentence scheduling and the PCM feed."""
+from __future__ import annotations
+import asyncio
+import pathlib
+import shutil
+import subprocess
+import tempfile
+from . import audio
+
+
+def voices() -> dict:
+    names = {"Tingting": "婷婷 · macOS 普通话", "Meijia": "美佳 · macOS 台湾中文", "Sinji": "善怡 · macOS 粤语"}
+    listing = subprocess.check_output(["/usr/bin/say", "-v", "?"], text=True)
+    installed = {line.split()[0] for line in listing.splitlines() if line.strip()}
+    return {name: {"name": name, "label": label, "kind": "system", "voice": name}
+            for name, label in names.items() if name in installed}
+
+
+class MacOSTTS:
+    cfg_base = "macos://say"
+
+    def __init__(self):
+        self._lock = asyncio.Lock()
+
+    def active_base(self) -> str:
+        return "macOS 系统语音（初始验证音色）"
+
+    @staticmethod
+    def _synth(text: str, preset: dict) -> bytes:
+        if not shutil.which("say"):
+            raise RuntimeError("当前系统没有 macOS say，请配置 OmniVoice 服务")
+        with tempfile.TemporaryDirectory(prefix="xiaoya-tts-") as folder:
+            root = pathlib.Path(folder)
+            (root / "text.txt").write_text(text, encoding="utf-8")
+            subprocess.run(["/usr/bin/say", "-v", preset.get("voice") or preset.get("name") or "Tingting",
+                            "-f", str(root / "text.txt"), "-o", str(root / "speech.aiff")],
+                           check=True, capture_output=True, timeout=60)
+            return audio.decode_to_pcm(str(root / "speech.aiff"))
+
+    async def synth_pcm(self, text: str, preset: dict) -> bytes:
+        if not text.strip():
+            return b""
+        async with self._lock:
+            return await asyncio.to_thread(self._synth, text, preset)
