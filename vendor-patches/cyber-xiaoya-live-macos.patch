+// Offline checks: exercise the actual stage adapter with deferred HTTP and media callbacks.
+const fs=require('node:fs'),vm=require('node:vm'),assert=require('node:assert/strict'),test=require('node:test');
+const html=fs.readFileSync(require('node:path').join(__dirname,'../stage/index.html'),'utf8');
+const js=html.split('const obsMode = ')[1].split('\nfunction toast')[0];
+function setup(obs){
+ const nodes=Object.fromEntries(['video','videoWrap','btnStop','btnGo','maskCap'].map(k=>[k,{style:{}}]));
+ nodes.videoWrap.querySelectorAll=()=>[nodes.video];
+ const calls=[],timers=[];
+ const ctx={URLSearchParams,crypto:{randomUUID:()=> 'test-viewer'},location:{search:obs?'?obs=1':''},
+  state:{liveId:null,joined:false,phase:'idle'},document:{body:{classList:{toggle(){}}}},
+  $:id=>nodes[id],Date,setInterval:fn=>timers.push(fn),
+  api:async path=>{calls.push(path);return {rtc:{}}},
+  joinRtc:async()=>{calls.push('join');ctx.state.joined=true},
+  leaveRtc:()=>{ctx.invalidateViewer?.();ctx.state.joined=false},showAvatarStill:()=>{},
+ };
+ vm.createContext(ctx);vm.runInContext('const obsMode = '+js+'\nglobalThis.sync=syncViewer;',ctx);
+ return {ctx,calls,timers,nodes};
+}
+test('controller does not consume the RTC identity',async()=>{
+ const t=setup(false);await t.ctx.sync({active:true,live_id:'live',local:{viewer:{frames_received:true}}});
+ assert.equal(t.ctx.state.liveId,'live');assert.equal(t.calls.length,0);
+});
+test('idle OBS sends readiness without creating a session',async()=>{
+ const t=setup(true);await t.timers[0]();assert.deepEqual(t.calls,['/api/local/viewer/heartbeat']);
+});
+test('repeated polling joins only once',async()=>{
+ const t=setup(true);await t.ctx.sync({active:true,live_id:'live'});await t.ctx.sync({active:true,live_id:'live'});
+ assert.deepEqual(t.calls,['/api/local/viewer/claim','join']);
+});
+test('join completing after stop is discarded',async()=>{
+ const t=setup(true);t.ctx.joinRtc=async()=>{t.ctx.state.liveId=null;t.ctx.state.joined=true;};
+ await t.ctx.sync({active:true,live_id:'live'});assert.equal(t.ctx.state.joined,false);
+});
+test('late old heartbeat failure must not destroy a new session',async()=>{
+ const t=setup(true);await t.ctx.sync({active:true,live_id:'old'});
+ let reject;t.ctx.api=()=>new Promise((_,bad)=>{reject=bad;});const heartbeat=t.timers[0]();
+ t.ctx.state.liveId='new';t.ctx.state.joined=true;reject(new Error('expired old lease'));await heartbeat;
+ assert.equal(t.ctx.state.joined,true);
+});
