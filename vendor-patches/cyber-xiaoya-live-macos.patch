+        self.created = asyncio.Event()
+        self.release = asyncio.Event()
+        self.release.set()
+        self.fail = False
+        self.starts = 0
+        self.stops = []
+    def _voices(self): return {}
+    def status(self, since=-1): return {'active': self.phase == 'live'}
+    async def start(self, overrides=None):
+        self.starts += 1
+        self.phase = 'creating'
+        self.live_id = 'fake-session'
+        self.on_live_created(self.live_id)
+        self.created.set()
+        await self.release.wait()
+        if self.fail:
+            self.phase = 'idle'
+            raise RuntimeError('simulated signaling failure')
+        self.phase = 'live'
+        return {'live_id': self.live_id}
+    async def stop(self, reason):
+        self.stops.append(reason)
+        await self.finalize(reason)
+        return {'ok': True}
+    async def finalize(self, reason): self.phase = 'idle'
+
+class RuntimeTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        self.conf = self.root / 'config.json'
