+ const t=setup(true);await t.ctx.sync({active:true,live_id:'old'});await t.ctx.sync({active:true,live_id:'new'});
+ assert.equal(t.ctx.state.liveId,'new');assert.equal(t.calls.filter(x=>x==='join').length,2);
+});
