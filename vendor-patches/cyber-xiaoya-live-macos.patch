@@ -0,0 +1,352 @@
+"""Local integration only: reuse upstream engine and existing workspace usage ledger.
+
+No LLM, song, danmaku, action or PCM scheduler is reimplemented here.
+"""
+from __future__ import annotations
+import asyncio
+import copy
+import json
+import math
+import os
+from pathlib import Path
+import shutil
+import time
+from urllib.parse import urlsplit
+
+from fastapi import HTTPException
+from fastapi.responses import JSONResponse, FileResponse
+from . import config, engine as engine_module
+from .tts import macos, omnivoice
+from .llm import LLMClient
+from .vidu import client as vidu
+from live.platform import UsageLedger
+
+ROOT = Path(os.environ["AVATAR_WORKSPACE_ROOT"]).resolve()
+
+
+class LocalRuntime:
+    def __init__(self, engine):
+        self.engine = engine
+        self.ledger = UsageLedger(ROOT)
+        self.lock = asyncio.Lock()
+        self.stop_requested = False
+        self.created_id = None
+        self.guard = None
+        self.finishing = None
+        self.created_at = 0
+        self.credit_check = {"checked": False}
+        self.viewer = {}
+        self.obs_present_at = 0
+        self._start = engine.start
+        self._stop = engine.stop
+        self._finalize = engine.finalize
+        self._status = engine.status
+        self._voices = engine._voices
+        self._public = config.public
+        self._patch = config.patch
+        self.mac_voices = macos.voices()
+        self.tts_kind = None
+        self.tts_signature = None
+        self.select_tts()
+        engine.on_live_created = self.on_created
+        engine.start, engine.stop, engine.finalize = self.start, self.stop, self.finalize
+        engine.status, engine._voices = self.status, self.voices
+        config.public, config.patch = self.public, self.patch
+
+    def select_tts(self):
+        c = config.load().get("tts") or {}
+        kind = c.get("engine", "omnivoice")
+        signature = (kind, (c.get("omnivoice_base") or "").rstrip("/"), c.get("omnivoice_timeout_sec", 120))
+        if signature == self.tts_signature:
+            return
+        if kind == "macos":
+            self.engine.tts = macos.MacOSTTS()
+        elif kind == "omnivoice":
+            self.engine.tts = omnivoice.OmniVoiceTTS(c.get("omnivoice_base", ""), c.get("omnivoice_timeout_sec", 120))
+        else:
+            raise RuntimeError("本机适配支持 macos 或原版 omnivoice 语音")
+        self.tts_kind = kind
+        self.tts_signature = signature
+
+    @staticmethod
+    def validate_limits(conf):
+        fields = (("local", "budget_credits", 200, False),
+                  ("local", "daily_budget_credits", 3200, False),
+                  ("local", "credits_per_second", 1.5, False),
+                  ("local", "credit_price_rmb", .03125, False),
+                  ("session", "max_duration_seconds", 120, True),
+                  ("session", "idle_timeout_seconds", 120, True))
+        for group, key, default, integer in fields:
+            value = (conf.get(group) or {}).get(key, default)
+            try:
+                number = float(value)
+                valid = not isinstance(value, bool) and math.isfinite(number) and number > 0
+                if key == "credit_price_rmb": valid = math.isfinite(number) and number >= 0
+                if integer: valid = valid and int(value) == number
+            except (ValueError, TypeError, OverflowError):
+                valid = False
+            if not valid:
+                raise HTTPException(400, f"{group}.{key} 必须是有效的{'正整数' if integer else '数值'}，不能清空或禁用费用保护")
+
+    def voices(self):
+        return self.mac_voices if self.tts_kind == "macos" else self._voices()
+
+    def public(self):
+        result = self._public()
+        llm = result.setdefault("llm", {})
+        llm.pop("api_key", None)
+        llm["key_set"] = bool(self.engine.llm.api_key())
+        return result
+
+    def patch(self, updates):
+        updates = copy.deepcopy(updates or {})
+        if not isinstance(updates, dict) or any(not isinstance(updates[k], dict) for k in ("llm", "tts", "local", "session", "vidu") if k in updates):
+            raise HTTPException(400, "设置分组必须是对象")
+        self.validate_limits(config.deep_merge(config.load(), updates))
+        sensitive = bool(updates.get("vidu") or (set(updates.get("llm") or {}) & {"api_key", "key_file", "base_url", "model"})
+                         or (set(updates.get("tts") or {}) & {"engine", "omnivoice_base"}))
+        if sensitive and (self.engine.phase != "idle" or self.lock.locked() or self.ledger.unconfirmed()):
+            raise HTTPException(409, "请先停止并核对当前会话，再修改服务连接")
+        if "tts" in updates and updates["tts"].get("engine", self.tts_kind) not in ("macos", "omnivoice"):
+            raise HTTPException(400, "语音服务只能选 macos 或 omnivoice")
+        if "llm" in updates:
+            llm = updates["llm"]
+            base = llm.get("base_url")
+            if base and urlsplit(base).scheme not in ("http", "https"):
+                raise HTTPException(400, "大模型地址必须是 http(s) 地址")
+            if "api_key" in llm:
+                value = str(llm.pop("api_key")).strip()
+                if value:
+                    if len(value) > 4096 or any(c.isspace() for c in value):
+                        raise HTTPException(400, "Key 格式不正确")
+                    folder = ROOT / ".secrets"
+                    folder.mkdir(mode=0o700, exist_ok=True)
+                    target = folder / "llm.key"
+                    temp = folder / ".llm.key.tmp"
+                    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+                    with os.fdopen(fd, "w") as f: f.write(value)
+                    temp.chmod(0o600); temp.replace(target)
+                    llm["key_file"] = str(target)
+        result = self._patch(updates)
+        self.select_tts()
+        return result
+
+    def local_status(self):
+        c = config.load()
+        limits = c.get("local") or {}
+        return {"app_id": "cyber-xiaoya-live-local", "workspace": str(ROOT), "pid": os.getpid(),
+                "upstream": "965f13d5b83f565ccbe19507b43077ca6b84c19f", "adaptation": "macos-2",
+                "llm_ready": bool(self.engine.llm.api_key()), "vidu_ready": bool((c.get("vidu") or {}).get("api_key")),
+                "tts_engine": self.tts_kind, "tts_ready": bool(self.voices()), "ffmpeg_ready": bool(shutil.which("ffmpeg")),
+                "max_seconds": int((c.get("session") or {}).get("max_duration_seconds", 120)),
+                "budget_credits": float(limits.get("budget_credits", 200)), "credit_check": self.credit_check,
+                "obs_page_ready": time.time() - self.obs_present_at < 15,
+                "viewer": {"connected": bool(self.viewer and time.time() - self.viewer.get("heartbeat", 0) < 15),
+                           "frames_received": bool(self.viewer.get("frame_at")),
+                           "last_frame_at": self.viewer.get("frame_at", 0)},
+                "usage": self.ledger.summary(float(limits.get("credit_price_rmb", .03125)))}
+
+    def status(self, since=-1):
+        result = self._status(since)
+        local = self.local_status()
+        local.pop("usage", None)
+        result["local"] = local
+        return result
+
+    async def check_credits(self):
+        vidu.configure(config.load().get("vidu") or {})
+        result = await vidu.credits()
+        arrays = ("packages", "remains", "general_remains", "exclusive_remains")
+        empty = all(k in result and result[k] == [] for k in arrays)
+        self.credit_check = {"checked": True, "at": time.time(), "empty": empty}
+        return self.credit_check
+
+    async def reconcile(self):
+        vidu.configure(config.load().get("vidu") or {})
+        for live_id in self.ledger.unconfirmed():
+            live = (await vidu.get_live(live_id)).get("live") or {}
+            if live.get("status") != "ended":
+                raise RuntimeError("上一场云端结束状态尚未确认，请先核对 Vidu 会话")
+            self.ledger.update(live_id, live.get("credits_cost", 0), close=True, ended_at=live.get("end_time"), reason="开播前核对云端结束")
+
+    async def start(self, overrides=None):
+        if self.lock.locked() or (self.finishing and not self.finishing.done()) or self.engine.phase != "idle":
+            raise RuntimeError("会话尚在运行或清理，请先停止后再连线")
+        async with self.lock:
+            self.stop_requested = False
+            self.created_id = None
+            try:
+                self.validate_limits(config.load())
+                if not self.engine.llm.api_key():
+                    raise RuntimeError("请在设置的大模型栏目填写地址、模型名和 API Key")
+                if not self.voices():
+                    raise RuntimeError("没有可用音色，请配置语音服务")
+                if time.time() - self.obs_present_at >= 15:
+                    raise RuntimeError("请先打开 OBS 并选择“原版小沐直播”场景，等画面加载后再连线")
+                await self.reconcile()
+                usage = self.local_status()["usage"]
+                if usage["today_credits"] >= float((config.load().get("local") or {}).get("daily_budget_credits", 3200)):
+                    raise RuntimeError("已达到今日预算，未创建新会话")
+                if (await self.check_credits())["empty"]:
+                    raise RuntimeError("Vidu API 账户没有可用积分包，请充值支持 S2 的 API 积分后再连线")
+                if self.stop_requested:
+                    raise RuntimeError("连线已取消，未创建云端会话")
+                result = await self._start(overrides)
+                if self.stop_requested:
+                    await self._stop("stopped_during_start")
+                    raise RuntimeError("连线过程已取消，新会话已执行关闭")
+                return result
+            except BaseException:
+                if self.created_id:
+                    await self.finish_record()
+                raise
+
+    def on_created(self, live_id):
+        self.created_id, self.created_at = live_id, time.time()
+        self.viewer = {}
+        rate = float((config.load().get("local") or {}).get("credits_per_second", 1.5))
+        self.ledger.start(live_id, (config.load().get("avatar") or {}).get("name", "原版数字人"), rate)
+        self.guard = asyncio.create_task(self.watch_budget())
+
+    async def watch_budget(self):
+        while self.created_id and not self.stop_requested:
+            await asyncio.sleep(1)
+            c = config.load(); limits = c.get("local") or {}
+            self.ledger.update(self.created_id)
+            spent = self.ledger.total_credits({self.created_id})
+            daily = self.ledger.summary(float(limits.get("credit_price_rmb", .03125)))["today_credits"]
+            timed_out = time.time() - self.created_at >= int((c.get("session") or {}).get("max_duration_seconds", 120))
+            # A successful RTC join is not evidence of decoded video. OBS reports
+            # actual frames; stop after an initial grace period or a stalled feed.
+            frame_at = self.viewer.get("frame_at", 0)
+            no_picture = (time.time() - frame_at > 20 if frame_at else time.time() - self.created_at > 60)
+            if no_picture:
+                self.guard = None  # This task owns stop; finalization must not cancel its caller.
+                await self.stop("local_no_video_frames")
+                return
+            if timed_out or spent >= float(limits.get("budget_credits", 200)) or daily >= float(limits.get("daily_budget_credits", 3200)):
+                self.guard = None
+                await self.stop("local_time_or_credit_limit")
+                return
+
+    def viewer_claim(self, client_id, live_id):
+        if not client_id or len(client_id) > 100:
+            raise HTTPException(400, "缺少有效的画面端标识")
+        if self.engine.phase != "live" or live_id != self.created_id:
+            raise HTTPException(409, "当前没有可接收的会话")
+        now = time.time()
+        if self.viewer and self.viewer["client_id"] != client_id and now - self.viewer["heartbeat"] < 15:
+            raise HTTPException(409, "画面已由另一个 OBS 页面接收")
+        if self.viewer.get("client_id") != client_id:
+            self.viewer = {"client_id": client_id, "frame_at": 0}
+        self.viewer["heartbeat"] = now
+        return {"rtc": self.engine.rtc, "live_id": live_id}
+
+    def viewer_heartbeat(self, client_id, live_id, frame):
+        if not live_id and self.engine.phase == "idle" and client_id:
+            self.obs_present_at = time.time()
+            return {"ok": True, "idle": True}
+        if self.engine.phase != "live" or live_id != self.created_id or client_id != self.viewer.get("client_id"):
+            raise HTTPException(409, "画面接收资格已失效")
+        self.obs_present_at = time.time()
+        self.viewer["heartbeat"] = time.time()
+        if frame:
+            self.viewer["frame_at"] = time.time()
+        return {"ok": True}
+
+    async def finish_record(self):
+        live_id, self.created_id = self.created_id, None
+        self.viewer = {}
+        if self.guard and self.guard is not asyncio.current_task():
+            self.guard.cancel()
+            await asyncio.gather(self.guard, return_exceptions=True)
+        if live_id:
+            try:
+                live = (await vidu.get_live(live_id)).get("live") or {}
+                self.ledger.update(live_id, live.get("credits_cost", 0), close=True,
+                    confirmed=live.get("status") == "ended", ended_at=live.get("end_time"), reason="原版会话结束核对")
+            except Exception:
+                self.ledger.update(live_id, close=True, confirmed=False, reason="原版会话结束状态待核对")
+
+    async def finalize(self, reason):
+        if not self.finishing or self.finishing.done():
+            async def finish():
+                try:
+                    return await self._finalize(reason)
+                finally:
+                    await self.finish_record()
+            self.finishing = asyncio.create_task(finish())
+        return await asyncio.shield(self.finishing)
+
+    async def stop(self, reason="user_end"):
+        self.stop_requested = True
+        async with self.lock:
+            return await self._stop(reason)
+
+    async def shutdown(self):
+        await self.stop("service_shutdown")
+        source = Path(__file__).parent.resolve()
+        current = asyncio.current_task()
+        pending = []
+        for task in asyncio.all_tasks():
+            code = getattr(task.get_coro(), "cr_code", None)
+            if task is not current and not task.done() and code and Path(code.co_filename).resolve().is_relative_to(source):
+                pending.append(task); task.cancel()
+        await asyncio.gather(*pending, return_exceptions=True)
+        await vidu.close()
+
+
+def install(app, engine):
+    runtime = LocalRuntime(engine)
+
+    @app.middleware("http")
+    async def loopback_only(request, call_next):
+        if request.url.hostname not in ("127.0.0.1", "localhost", "::1"):
+            return JSONResponse({"detail": "仅允许本机访问"}, status_code=403)
+        origin = request.headers.get("origin")
+        if request.method not in ("GET", "HEAD", "OPTIONS") and (origin and origin != str(request.base_url).rstrip("/") or request.headers.get("sec-fetch-site") == "cross-site"):
+            return JSONResponse({"detail": "请从本机舞台页操作"}, status_code=403)
+        return await call_next(request)
+
+    @app.get("/api/local/status")
+    async def status():
+        return runtime.local_status()
+
+    @app.get("/vendor/aliyun-rtc-sdk-7.1.9.js")
+    async def rtc_sdk():
+        return FileResponse(ROOT / "static/vendor/aliyun-rtc-sdk-7.1.9.js")
+
+    @app.get("/local-avatar.png")
+    async def local_avatar():
+        return FileResponse(ROOT / "starter/xiaomu-navy.png")
+
+    @app.post("/api/local/check-credits")
+    async def credits():
+        return await runtime.check_credits()
+
+    @app.post("/api/local/viewer/claim")
+    async def viewer_claim(body: dict):
+        return runtime.viewer_claim(str(body.get("client_id", "")), body.get("live_id"))
+
+    @app.post("/api/local/viewer/heartbeat")
+    async def viewer_heartbeat(body: dict):
+        return runtime.viewer_heartbeat(body.get("client_id"), body.get("live_id"), body.get("frame") is True)
+
+    @app.post("/api/local/check-llm")
+    async def llm_check():
+        if engine.phase != "idle" or runtime.lock.locked():
+            raise HTTPException(409, "请先停止会话")
+        async with runtime.lock:
+            probe_config = copy.deepcopy(config.load().get("llm") or {})
+            probe = LLMClient(lambda: probe_config)
+            try:
+                async with asyncio.timeout(30):
+                    text = "".join([part async for part in probe.stream("请只回复四个字：连接成功。")])
+                return {"ok": bool(text.strip()), "reply": text[:160]}
+            except Exception as error:
+                msg = str(error)
+                key = probe.api_key()
+                raise HTTPException(502, msg.replace(key, "[hidden]")[:200] if key else msg[:200]) from error
+
+    app.router.add_event_handler("shutdown", runtime.shutdown)
+    return runtime
