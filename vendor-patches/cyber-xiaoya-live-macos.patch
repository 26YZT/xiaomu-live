+    async def test_llm_probe_isolated_from_live_history_and_start(self):
+        import httpx
+        from fastapi import FastAPI
+        config.public, config.patch = self.saved[2:]
+        app = FastAPI(); self.e = FakeEngine(); self.r = ls.install(app, self.e)
+        self.r.obs_present_at = time.time()
+        self.e.llm.history.append({'role':'user','content':'keep this conversation'})
+        entered, release, clients = asyncio.Event(), asyncio.Event(), []
+        async def stream(client, text):
+            clients.append(client); entered.set(); await release.wait(); yield '连接成功'
+        with patch.object(LLMClient, 'stream', stream):
+            async with httpx.AsyncClient(transport=httpx.ASGITransport(app=app), base_url='http://127.0.0.1:8795') as client:
