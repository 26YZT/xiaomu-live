+"""Mac launcher using the existing workspace single-instance lock and upstream app."""
+import os
+import sys
+from pathlib import Path
+import uvicorn
+
+root = Path(__file__).resolve().parents[3]
+os.environ["AVATAR_WORKSPACE_ROOT"] = str(root)
+sys.path.insert(0, str(root))
+from live.platform import server_instance
+
+if __name__ == "__main__":
+    with server_instance(root):
+        from .bridge import app, engine
+        from .local_support import install
+        install(app, engine)
+        uvicorn.run(app, host="127.0.0.1", port=8795, log_level="info")
