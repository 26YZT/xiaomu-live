+            'vidu': {}, 'session': {'max_duration_seconds': 120}, 'avatar': {'name': 'test'},
+            'local': {'budget_credits': 200, 'daily_budget_credits': 3200}}))
+        self.saved = (config._conf, config.CONF_PATH, config.public, config.patch)
